<Project Sdk="Microsoft.NET.Sdk">
  <!-- Testy. Własność: annotations-forms. xUnit i test SDK dodaje tests/Directory.Build.props.
       Rendering (PDFium) – tylko do sprawdzenia, że zapisane adnotacje i wartości pól są widoczne w renderze. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ZetPDF.Annotations.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZetPDF.TestData\ZetPDF.TestData.csproj" />
    <ProjectReference Include="..\..\src\ZetPDF.Core\ZetPDF.Core.csproj" />
    <ProjectReference Include="..\..\src\ZetPDF.Rendering\ZetPDF.Rendering.csproj" />
    <ProjectReference Include="..\..\src\ZetPDF.Viewer\ZetPDF.Viewer.csproj" />
    <ProjectReference Include="..\..\src\ZetPDF.Annotations\ZetPDF.Annotations.csproj" />
    <PackageReference Include="PdfPig" Version="$(PdfPigVersion)" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
