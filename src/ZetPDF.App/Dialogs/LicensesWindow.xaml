<Window x:Class="ZetPDF.App.Dialogs.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZetPDF.Core.Localization;assembly=ZetPDF.Core"
        Title="{loc:Loc Cmd.Help.Licenses}" Width="860" Height="620" MinWidth="560" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Shell.LicensesWindow">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource Brush.Surface.Alt}">
            <DockPanel>
                <Button x:Name="CopyButton" DockPanel.Dock="Left" Content="{loc:Loc Shell.Licenses.Copy}" />
                <Button Content="{loc:Loc Core.Button.Close}" IsDefault="True" IsCancel="True" MinWidth="88" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Shell.Licenses.Intro}" TextWrapping="Wrap" Margin="16,14,16,10" Style="{StaticResource Shell.Text.Secondary}" />
        <Grid Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="LibraryList" DisplayMemberPath="Name" AutomationProperties.Name="{loc:Loc Shell.About.Libraries}" />
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <TextBox x:Name="LicenseText" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="12"
                     FontFamily="{DynamicResource Font.Family.Mono}" Padding="10,8" />
        </Grid>
    </DockPanel>
</Window>
