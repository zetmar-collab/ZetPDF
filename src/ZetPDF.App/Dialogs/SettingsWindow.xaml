<Window x:Class="ZetPDF.App.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZetPDF.Core.Localization;assembly=ZetPDF.Core"
        xmlns:c="clr-namespace:ZetPDF.Core.Contracts;assembly=ZetPDF.Core"
        Title="{loc:Loc Cmd.File.Settings}" Width="640" Height="560" MinWidth="520" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Shell.SettingsWindow">
    <Window.Resources>
        <Style x:Key="Err" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text.Error}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Shell.Text.Secondary}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource Brush.Surface.Alt}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="{loc:Loc Core.Button.Ok}" IsDefault="True" MinWidth="88" IsEnabled="{Binding IsValid}" />
                <Button x:Name="CancelButton" Content="{loc:Loc Core.Button.Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
                <Button x:Name="ApplyButton" Content="{loc:Loc Core.Button.Apply}" MinWidth="88" Margin="8,0,0,0" IsEnabled="{Binding IsValid}" />
            </StackPanel>
        </Border>

        <TabControl Margin="12,10,12,0" Padding="16,12" BorderThickness="0,1,0,0" Background="Transparent">
            <!-- Ogólne: język i motyw (na żywo) -->
            <TabItem Header="{loc:Loc Shell.Settings.Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="{loc:Loc Shell.Settings.Language}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Language}" MinWidth="260" HorizontalAlignment="Left"
                                  AutomationProperties.AutomationId="Shell.Settings.Language">
                            <ComboBoxItem Tag="" Content="{loc:Loc Shell.Settings.Language.System}" />
                            <ComboBoxItem Tag="pl" Content="{loc:Loc Core.Language.pl}" />
                            <ComboBoxItem Tag="en" Content="{loc:Loc Core.Language.en}" />
                        </ComboBox>
                        <TextBlock Text="{loc:Loc Shell.Settings.Language.Hint}" Style="{StaticResource Hint}" />

                        <TextBlock Text="{loc:Loc Shell.Settings.Theme}" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                        <StackPanel AutomationProperties.AutomationId="Shell.Settings.Theme">
                            <RadioButton x:Name="ThemeSystem" Content="{loc:Loc Core.Theme.System}" Margin="0,2" />
                            <RadioButton x:Name="ThemeLight" Content="{loc:Loc Core.Theme.Light}" Margin="0,2" />
                            <RadioButton x:Name="ThemeDark" Content="{loc:Loc Core.Theme.Dark}" Margin="0,2" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Shell.Settings.Theme.Hint}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tożsamość -->
            <TabItem Header="{loc:Loc Shell.Settings.Tab.Identity}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Left" MinWidth="360">
                        <TextBlock Text="{loc:Loc Shell.Settings.Identity.Hint}" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Loc Shell.Settings.Identity.Name}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Shell.Settings.Identity.Name}" />
                        <TextBlock Text="{loc:Loc Shell.Settings.Identity.Organization}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Shell.Settings.Identity.Organization}" />
                        <TextBlock Text="{loc:Loc Shell.Settings.Identity.Email}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Shell.Settings.Identity.Email}" />
                        <TextBlock Text="{Binding EmailError}" Style="{StaticResource Err}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Dokumenty: powiększenie, układ, Cofnij, ostatnie pliki -->
            <TabItem Header="{loc:Loc Shell.Settings.Tab.Documents}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Left" MinWidth="360">
                        <TextBlock Text="{loc:Loc Shell.Settings.DefaultZoom}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ZoomMode}" MinWidth="220">
                                <ComboBoxItem Tag="{x:Static c:ZoomMode.FitPage}" Content="{loc:Loc Cmd.View.FitPage}" />
                                <ComboBoxItem Tag="{x:Static c:ZoomMode.FitWidth}" Content="{loc:Loc Cmd.View.FitWidth}" />
                                <ComboBoxItem Tag="{x:Static c:ZoomMode.FitVisible}" Content="{loc:Loc Cmd.View.FitVisible}" />
                                <ComboBoxItem Tag="{x:Static c:ZoomMode.ActualSize}" Content="{loc:Loc Cmd.View.ActualSize}" />
                                <ComboBoxItem Tag="{x:Static c:ZoomMode.Custom}" Content="{loc:Loc Shell.Settings.Zoom.Custom}" />
                            </ComboBox>
                            <TextBox Width="80" Margin="8,0,0,0" Text="{Binding ZoomPercent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomZoom}"
                                     AutomationProperties.Name="{loc:Loc Shell.Settings.Zoom.Custom}" />
                            <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding ZoomError}" Style="{StaticResource Err}" />

                        <TextBlock Text="{loc:Loc Shell.Settings.DefaultLayout}" Style="{StaticResource FieldLabel}" />
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Layout}" MinWidth="220" HorizontalAlignment="Left">
                            <ComboBoxItem Tag="{x:Static c:PageLayoutMode.SinglePage}" Content="{loc:Loc Cmd.View.SinglePage}" />
                            <ComboBoxItem Tag="{x:Static c:PageLayoutMode.Continuous}" Content="{loc:Loc Cmd.View.Continuous}" />
                            <ComboBoxItem Tag="{x:Static c:PageLayoutMode.TwoPages}" Content="{loc:Loc Cmd.View.TwoPages}" />
                            <ComboBoxItem Tag="{x:Static c:PageLayoutMode.TwoPagesContinuous}" Content="{loc:Loc Cmd.View.TwoPagesContinuous}" />
                        </ComboBox>
                        <TextBlock Text="{loc:Loc Shell.Settings.ViewHint}" Style="{StaticResource Hint}" />

                        <TextBlock Text="{loc:Loc Shell.Settings.UndoLevels}" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                        <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding UndoLevels, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc Shell.Settings.UndoLevels}" />
                        <TextBlock Text="{Binding UndoError}" Style="{StaticResource Err}" />

                        <TextBlock Text="{loc:Loc Shell.Settings.MaxRecent}" Style="{StaticResource FieldLabel}" />
                        <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding MaxRecentFiles, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc Shell.Settings.MaxRecent}" />
                        <TextBlock Text="{Binding RecentError}" Style="{StaticResource Err}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Klawiatura -->
            <TabItem Header="{loc:Loc Shell.Settings.Tab.Keyboard}">
                <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                    <CheckBox Content="{loc:Loc Shell.Settings.SingleKey}" IsChecked="{Binding SingleKeyShortcuts}"
                              AutomationProperties.AutomationId="Shell.Settings.SingleKey" />
                    <TextBlock Text="{loc:Loc Shell.Settings.SingleKey.Hint}" Style="{StaticResource Hint}" Margin="26,4,0,0" />
                    <Button x:Name="ShortcutsButton" Content="{loc:Loc Cmd.Help.Shortcuts}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Zaawansowane: TSA, folder tymczasowy, dziennik -->
            <TabItem Header="{loc:Loc Shell.Settings.Tab.Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Left" MinWidth="380">
                        <TextBlock Text="{loc:Loc Shell.Settings.Tsa}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TsaUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Shell.Settings.Tsa}"
                                 AutomationProperties.AutomationId="Shell.Settings.Tsa" />
                        <TextBlock Text="{Binding TsaError}" Style="{StaticResource Err}" />
                        <TextBlock Text="{loc:Loc Shell.Settings.Tsa.Hint}" Style="{StaticResource Hint}" />

                        <TextBlock Text="{loc:Loc Shell.Settings.TempFolder}" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                        <DockPanel>
                            <Button x:Name="BrowseTempButton" DockPanel.Dock="Right" Content="{loc:Loc Core.Button.Browse}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding TempFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Shell.Settings.TempFolder}" />
                        </DockPanel>
                        <TextBlock Text="{Binding TempFolderError}" Style="{StaticResource Err}" />
                        <TextBlock Text="{loc:Loc Shell.Settings.TempFolder.Hint}" Style="{StaticResource Hint}" />

                        <TextBlock Text="{loc:Loc Shell.Settings.LogFolder}" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
                        <DockPanel>
                            <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Content="{loc:Loc Shell.Settings.Open}" Margin="8,0,0,0" />
                            <TextBox x:Name="LogFolderBox" IsReadOnly="True" />
                        </DockPanel>

                        <Border Margin="0,20,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource Brush.Surface.Alt}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Shell.IconText}" Margin="0,0,10,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource Brush.Status.Success}" />
                                <TextBlock Text="{loc:Loc Shell.About.Privacy}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
