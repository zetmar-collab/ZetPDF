<Window x:Class="ZetPDF.App.Dialogs.DocumentPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZetPDF.Core.Localization;assembly=ZetPDF.Core"
        Title="{loc:Loc Cmd.File.Properties}" Width="620" Height="600" MinWidth="480" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Shell.PropertiesWindow">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource Brush.Surface.Alt}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="{loc:Loc Core.Button.Ok}" IsDefault="True" MinWidth="88" />
                <Button Content="{loc:Loc Core.Button.Cancel}" IsCancel="True" MinWidth="88" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
        <TabControl Margin="12,10,12,0" Padding="16,12" Background="Transparent">
            <TabItem Header="{loc:Loc Shell.Properties.Tab.Description}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DescriptionGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Loc Shell.Properties.Title}" VerticalAlignment="Center" Margin="0,0,16,8" />
                        <TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.Name="{loc:Loc Shell.Properties.Title}" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc Shell.Properties.Author}" VerticalAlignment="Center" Margin="0,0,16,8" />
                        <TextBox x:Name="AuthorBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.Name="{loc:Loc Shell.Properties.Author}" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc Shell.Properties.Subject}" VerticalAlignment="Center" Margin="0,0,16,8" />
                        <TextBox x:Name="SubjectBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.Name="{loc:Loc Shell.Properties.Subject}" />
                        <TextBlock Grid.Row="3" Text="{loc:Loc Shell.Properties.Keywords}" VerticalAlignment="Top" Margin="0,6,16,8" />
                        <TextBox x:Name="KeywordsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Height="64" AcceptsReturn="False" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc Shell.Properties.Keywords}" />
                        <TextBlock x:Name="ReadOnlyNote" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,4,0,8"
                                   Text="{loc:Loc Shell.Properties.ReadOnly}" Style="{StaticResource Shell.Text.Error}" />
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{loc:Loc Shell.Properties.UndoHint}" Style="{StaticResource Shell.Text.Secondary}" FontSize="12" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Loc Shell.Properties.Tab.Info}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="InfoGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
