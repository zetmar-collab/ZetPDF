<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Motyw ciemny ZetPDF (własność: ui-shell). Musi definiować KAŻDY klucz z ZetPDF.Core.Theming.ThemeKeys. -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF262626" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FFC2C2C2" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FF0B0B0B" />
    <SolidColorBrush x:Key="Brush.Text.Link" Color="#FF7CBFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#FF7CBFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF5AACF7" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF78BBF9" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#FF3D93E0" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="Brush.Control.Background.Hover" Color="#FF383838" />
    <SolidColorBrush x:Key="Brush.Control.Background.Pressed" Color="#FF444444" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#FF555555" />
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#FF6E6E6E" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#FF264F78" />
    <SolidColorBrush x:Key="Brush.Selection.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#FF6A6A6A" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#FF262626" />
    <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="#FF333333" />
    <SolidColorBrush x:Key="Brush.Tooltip.Text" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#FF181818" />
    <SolidColorBrush x:Key="Brush.StatusBar.Text" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="Brush.Viewer.Background" Color="#FF141414" />
    <SolidColorBrush x:Key="Brush.Viewer.PageBorder" Color="#FF555555" />
    <SolidColorBrush x:Key="Brush.Viewer.PageShadow" Color="#80000000" />
    <SolidColorBrush x:Key="Brush.Viewer.SearchHit" Color="#66FFD400" />
    <SolidColorBrush x:Key="Brush.Viewer.SearchHit.Current" Color="#99FF8C00" />
    <SolidColorBrush x:Key="Brush.Viewer.TextSelection" Color="#553399FF" />
    <SolidColorBrush x:Key="Brush.Viewer.Overlay.Outline" Color="#FF7CBFFF" />
    <SolidColorBrush x:Key="Brush.Viewer.Overlay.Handle" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Brush.Viewer.FormField.Highlight" Color="#33498FE0" />
    <SolidColorBrush x:Key="Brush.Viewer.RedactionMark" Color="#66FF6B6B" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#FFFFC857" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="#FF7BD88F" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="#FF7CBFFF" />
    <SolidColorBrush x:Key="Brush.Diff.Inserted" Color="#5530A14E" />
    <SolidColorBrush x:Key="Brush.Diff.Deleted" Color="#55D13438" />
    <SolidColorBrush x:Key="Brush.Diff.Changed" Color="#55E0A800" />
    <FontFamily x:Key="Font.Family.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Family.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
