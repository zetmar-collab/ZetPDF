<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Motyw ciemny ZetPDF (własność: ui-shell). Musi definiować KAŻDY klucz z ZetPDF.Core.Theming.ThemeKeys.
         To (obok Light.xaml) JEDYNE miejsce z kolorami interfejsu. Kontrast tekstu ≥ 4.5:1 sprawdza test ThemeContrastTests. -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#FF1C2023" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF23282B" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#FF2B3134" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="#FF292E32" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFF0F3F4" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FFBCC6CB" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FF737E84" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FF0A1212" />
    <SolidColorBrush x:Key="Brush.Text.Link" Color="#FF7FC8F2" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3A4246" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FF6C787E" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#FF6CD0C8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4FC1B9" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF6CD0C8" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#FF3AA9A1" />
    <SolidColorBrush x:Key="Brush.Control.Background" Color="#FF2C3236" />
    <SolidColorBrush x:Key="Brush.Control.Background.Hover" Color="#FF35403F" />
    <SolidColorBrush x:Key="Brush.Control.Background.Pressed" Color="#FF3F4D4C" />
    <SolidColorBrush x:Key="Brush.Control.Border" Color="#FF525C61" />
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FF181C1E" />
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#FF6C787E" />
    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#FF1E4E4A" />
    <SolidColorBrush x:Key="Brush.Selection.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#FF5F6A70" />
    <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#FF23282B" />
    <SolidColorBrush x:Key="Brush.Tooltip.Background" Color="#FF30373B" />
    <SolidColorBrush x:Key="Brush.Tooltip.Text" Color="#FFF0F3F4" />
    <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#FF16191B" />
    <SolidColorBrush x:Key="Brush.StatusBar.Text" Color="#FFE3E8EA" />
    <SolidColorBrush x:Key="Brush.Viewer.Background" Color="#FF121517" />
    <SolidColorBrush x:Key="Brush.Viewer.PageBorder" Color="#FF525C61" />
    <SolidColorBrush x:Key="Brush.Viewer.PageShadow" Color="#80000000" />
    <SolidColorBrush x:Key="Brush.Viewer.SearchHit" Color="#66FFD400" />
    <SolidColorBrush x:Key="Brush.Viewer.SearchHit.Current" Color="#99FF8C00" />
    <SolidColorBrush x:Key="Brush.Viewer.TextSelection" Color="#553399FF" />
    <SolidColorBrush x:Key="Brush.Viewer.Overlay.Outline" Color="#FF6CD0C8" />
    <SolidColorBrush x:Key="Brush.Viewer.Overlay.Handle" Color="#FF292E32" />
    <SolidColorBrush x:Key="Brush.Viewer.FormField.Highlight" Color="#33498FE0" />
    <SolidColorBrush x:Key="Brush.Viewer.RedactionMark" Color="#66FF6B6B" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="#FFFF8A80" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="#FFFFC857" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="#FF7BD88F" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="#FF7FC8F2" />
    <SolidColorBrush x:Key="Brush.Diff.Inserted" Color="#5530A14E" />
    <SolidColorBrush x:Key="Brush.Diff.Deleted" Color="#55D13438" />
    <SolidColorBrush x:Key="Brush.Diff.Changed" Color="#55E0A800" />
    <FontFamily x:Key="Font.Family.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Family.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
