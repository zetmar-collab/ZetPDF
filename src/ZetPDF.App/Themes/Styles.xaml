<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Style domyślne kontrolek oparte WYŁĄCZNIE na kluczach motywu (DynamicResource). Własność: ui-shell
         (rozbuduje o Button, TextBox, ComboBox, CheckBox, ListBox, TreeView, ScrollBar, ToolTip, ContextMenu,
         TabControl, DataGrid, tak by okna modułów wyglądały poprawnie w obu motywach). -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Window.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Ui}" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Tooltip.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Tooltip.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <Style x:Key="Shell.IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
