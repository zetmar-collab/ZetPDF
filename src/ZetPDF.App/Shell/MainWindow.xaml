<fluent:RibbonWindow x:Class="ZetPDF.App.Shell.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:fluent="urn:fluent-ribbon"
                     xmlns:loc="clr-namespace:ZetPDF.Core.Localization;assembly=ZetPDF.Core"
                     xmlns:shell="clr-namespace:ZetPDF.App.Shell"
                     Background="{DynamicResource Brush.Window.Background}"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     FontFamily="{DynamicResource Font.Family.Ui}"
                     Width="1280" Height="800" MinWidth="640" MinHeight="420"
                     UseLayoutRounding="True" AllowDrop="True"
                     Icon="pack://application:,,,/ZetPDF;component/Assets/ZetPDF.ico">
    <!-- Okno główne ZetPDF (własność: ui-shell). Wstążka, panele, karty i pasek stanu są tworzone w kodzie (MainWindow.xaml.cs). -->
    <DockPanel>
        <ContentControl x:Name="RibbonHost" DockPanel.Dock="Top" Focusable="False" IsTabStop="False" />

        <Border x:Name="StatusBarHost" DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.StatusBar.Background}" BorderBrush="{DynamicResource Brush.Border}" />

        <Grid x:Name="Workspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PanelColumn" Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pasek ikon paneli bocznych (F4) -->
            <Border x:Name="Rail" Grid.Column="0" BorderThickness="0,0,1,0"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}">
                <StackPanel x:Name="RailButtons" Margin="0,4,0,0" />
            </Border>

            <!-- Zawartość panelu bocznego -->
            <Border x:Name="PanelArea" Grid.Column="1" Background="{DynamicResource Brush.Surface}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Height="36" Margin="12,0,4,0">
                        <Button x:Name="PanelCloseButton" DockPanel.Dock="Right" Style="{StaticResource Shell.Button.Subtle}"
                                ToolTip="{loc:Loc Shell.Panel.Hide}" AutomationProperties.Name="{loc:Loc Shell.Panel.Hide}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Shell.IconText}" FontSize="11" />
                        </Button>
                        <TextBlock x:Name="PanelTitle" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Brush.Border}" />
                    <Grid>
                        <ContentControl x:Name="PanelContent" Focusable="False" IsTabStop="False" />
                        <TextBlock x:Name="PanelEmpty" Margin="16" TextWrapping="Wrap" Style="{StaticResource Shell.Text.Secondary}"
                                   Text="{loc:Loc Shell.Panel.Empty}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border}" />

            <!-- Karty dokumentów + widoki -->
            <DockPanel Grid.Column="3">
                <ListBox x:Name="DocumentStrip" DockPanel.Dock="Top" Visibility="Collapsed"
                         Style="{StaticResource Shell.DocumentStrip}" ItemContainerStyle="{StaticResource Shell.DocumentTab}"
                         AutomationProperties.AutomationId="Shell.DocumentTabs">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type shell:DocumentTab}">
                            <DockPanel ToolTip="{Binding ToolTip}">
                                <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource Shell.Button.Subtle}"
                                        MinWidth="20" MinHeight="20" Width="20" Height="20" Padding="0" Margin="8,0,0,0"
                                        ToolTip="{loc:Loc Cmd.File.Close}" AutomationProperties.Name="{loc:Loc Cmd.File.Close}">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Shell.IconText}" FontSize="9" />
                                </Button>
                                <Ellipse x:Name="ModifiedDot" DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,0,0"
                                         Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed" VerticalAlignment="Center"
                                         ToolTip="{loc:Loc Shell.Tab.Modified}" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                    <Setter TargetName="ModifiedDot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid x:Name="DocumentHost" Background="{DynamicResource Brush.Viewer.Background}">
                    <!-- Ekran startowy (brak dokumentu) -->
                    <ScrollViewer x:Name="EmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Padding="32,28" CornerRadius="10" MaxWidth="560"
                                Background="{DynamicResource Brush.Surface.Raised}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Image Source="pack://application:,,,/ZetPDF;component/Assets/ZetPDF-256.png" Width="56" Height="56" Margin="0,0,16,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Shell.AppTitle}" FontSize="26" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc Shell.Start.Tagline}" Style="{StaticResource Shell.Text.Secondary}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{loc:Loc Shell.NoDocument}" TextWrapping="Wrap" Margin="0,4,0,16" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <Button x:Name="StartOpenButton" Style="{StaticResource Shell.Button.Accent}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Shell.IconText}" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:Loc Shell.Start.Open}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StartSettingsButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Shell.IconText}" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:Loc Cmd.File.Settings}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <ContentControl x:Name="StartRecentHost" Focusable="False" IsTabStop="False" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Grid x:Name="ViewHost" />

                    <!-- Nakładka przeciągania plików -->
                    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="12" CornerRadius="10"
                            BorderThickness="2" BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Surface.Raised}" Opacity="0.94">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Shell.IconText}" FontSize="40" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{loc:Loc Shell.Drop.Hint}" FontSize="16" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</fluent:RibbonWindow>
