<Project Sdk="Microsoft.NET.Sdk">
  <!-- Edycja tekstu/obiektów, łącza, konwersje, redakcja, okna OCR. Własność: edit-convert-ocr. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZetPDF.Editing</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZetPDF.Core\ZetPDF.Core.csproj" />
    <ProjectReference Include="..\ZetPDF.Ocr\ZetPDF.Ocr.csproj" />
    <PackageReference Include="PdfPig" Version="$(PdfPigVersion)" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZetPDF.Editing.Tests" />
  </ItemGroup>
</Project>
