<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rdzeń: kontrakty (Contracts\ – zamrożone), model dokumentu, Cofnij/Ponów, usługi wspólne.
       Własność: architekt/koordynator. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>ZetPDF.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="$(PdfSharpVersion)" />
    <!-- PDFsharp 6.2.4 ciągnie Pkcs 8.0.1 (CVE-2026-84008/70162) – podnosimy do wersji z poprawką. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="$(PkcsVersion)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="$(MvvmToolkitVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MsExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZetPDF.Core.Tests" />
  </ItemGroup>
</Project>
